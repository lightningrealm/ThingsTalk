{
  "schemaVersion": 3,
  "title": "温度、电源与亮度",
  "payloadFormats": [
    {
      "id": "status",
      "label": "设备状态报文",
      "encoding": "BINARY",
      "prefixHex": "AA",
      "suffixHex": "55",
      "fields": [
        {
          "id": "temperature",
          "codec": "INT16",
          "byteOrder": "LITTLE_ENDIAN",
          "scale": 0.01
        },
        {
          "id": "power",
          "codec": "BOOLEAN"
        },
        {
          "id": "brightness",
          "codec": "UINT8"
        }
      ]
    },
    {
      "id": "setPower",
      "label": "电源控制报文",
      "encoding": "BINARY",
      "prefixHex": "A1",
      "suffixHex": "EE",
      "fields": [
        {
          "id": "command",
          "codec": "UINT8",
          "defaultValue": "2"
        },
        {
          "id": "power",
          "codec": "BOOLEAN"
        }
      ]
    },
    {
      "id": "setBrightness",
      "label": "亮度控制",
      "encoding": "BINARY",
      "prefixHex": "A1",
      "suffixHex": "EE",
      "fields": [
        {
          "id": "command",
          "codec": "UINT8",
          "defaultValue": "3"
        },
        {
          "id": "brightness",
          "codec": "UINT8"
        }
      ]
    },
    {
      "id": "locate",
      "label": "定位动作",
      "encoding": "BINARY",
      "prefixHex": "A1",
      "suffixHex": "EE",
      "fields": [
        {
          "id": "command",
          "codec": "UINT8",
          "defaultValue": "4"
        },
        {
          "id": "duration",
          "codec": "UINT8",
          "defaultValue": "1"
        }
      ]
    }
  ],
  "capabilities": [
    {
      "id": "temperature",
      "label": "温度",
      "type": "NUMBER",
      "minimum": -100,
      "maximum": 200,
      "unit": "℃"
    },
    {
      "id": "power",
      "label": "电源",
      "type": "BOOLEAN"
    },
    {
      "id": "brightness",
      "label": "亮度",
      "type": "NUMBER",
      "minimum": 0,
      "maximum": 100,
      "step": 1,
      "unit": "%"
    },
    {
      "id": "locate",
      "label": "定位一次",
      "type": "ACTION"
    },
    {
      "id": "message",
      "label": "发送文本",
      "type": "TEXT",
      "maxBytes": 64
